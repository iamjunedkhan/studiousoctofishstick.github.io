---
import { getCollection } from "astro:content";
import readingTime from "reading-time";

const allPosts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const postsWithTime = allPosts.map((post) => {
	const stats = readingTime(post.body || "");
	return {
		...post,
		readingTime: stats.text,
	};
});

const trendingPosts = postsWithTime.slice(0, 3);
---

<aside class="sidebar-container">
	<!-- Trending Widget -->
	<div class="sidebar-widget">
		<h3 class="widget-title">
			<svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
			Trending Now
		</h3>
		<div class="trending-list">
			{
				trendingPosts.map((post, idx) => (
					<a href={`${import.meta.env.BASE_URL}/blog/${post.id.replace("/index", "")}/`} class="trending-item">
						<span class="trending-number">{`0${idx + 1}`}</span>
						<div class="trending-details">
							<h4 class="trending-title">{post.data.title}</h4>
							<span class="trending-meta">{post.readingTime}</span>
						</div>
					</a>
				))
			}
		</div>
	</div>

	<!-- Upcoming Events Widget -->
	<div class="sidebar-widget">
		<h3 class="widget-title">
			<svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
			Upcoming Events
		</h3>
		<div class="events-list">
			<div class="event-item">
				<div class="event-date-block">
					<span class="event-day">18</span>
					<span class="event-month">Jun</span>
				</div>
				<div class="event-details">
					<h4 class="event-title">Agentforce World Tour London Solutions</h4>
					<span class="event-type">Webinar / Virtual</span>
				</div>
			</div>
			<div class="event-item">
				<div class="event-date-block">
					<span class="event-day">24</span>
					<span class="event-month">Jun</span>
				</div>
				<div class="event-details">
					<h4 class="event-title">Apex Enterprise Patterns Masterclass</h4>
					<span class="event-type">Developer Workshop</span>
				</div>
			</div>
			<div class="event-item">
				<div class="event-date-block">
					<span class="event-day">02</span>
					<span class="event-month">Jul</span>
				</div>
				<div class="event-details">
					<h4 class="event-title">Advanced LWC Optimization & Security</h4>
					<span class="event-type">Live Q&A Session</span>
				</div>
			</div>
		</div>
	</div>

	<!-- Newsletter Widget -->
	<div class="newsletter-sidebar-card">
		<h3>The Ultimate Dev Newsletter</h3>
		<p>Receive practical Salesforce developer tips, Apex architecture tutorials, and LWC hacks directly in your inbox.</p>
		<form class="newsletter-sidebar-form" onsubmit="event.preventDefault(); alert('Subscribed successfully to Salesforce Dev Hub Newsletter! (Simulated)'); this.reset();">
			<input type="email" placeholder="Your Email Address" required aria-label="Email address" />
			<button type="submit">Subscribe &rarr;</button>
		</form>
	</div>
</aside>
