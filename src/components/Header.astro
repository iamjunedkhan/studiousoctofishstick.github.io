---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
---

<header>
	<nav>
		<div class="logo">
			<h2>
				<a href="/">{SITE_TITLE}</a>
			</h2>
			<span class="tagline">Salesforce Tutorials & Developer Guides</span>
		</div>

		<div class="internal-links">
			<HeaderLink href="/studiousoctofishstick.github.io">Home</HeaderLink>
			<HeaderLink href="/studiousoctofishstick.github.io/blog">Articles</HeaderLink>
			<HeaderLink href="/studiousoctofishstick.github.io/categories/apex">Apex</HeaderLink>
			<HeaderLink href="/studiousoctofishstick.github.io/categories/lwc">LWC</HeaderLink>
			<HeaderLink href="/studiousoctofishstick.github.io/categories/agentforce">Agentforce</HeaderLink>
			<HeaderLink href="/studiousoctofishstick.github.io/about">About</HeaderLink>
		</div>

		<div class="social-links">
			<a
				href="https://github.com/iamjunedkhan"
				target="_blank"  
				aria-label="GitHub"
			>
				GitHub
			</a>

			<a
				href="https://linkedin.com/in/iamjunedkhan"
				target="_blank"
				aria-label="LinkedIn"
			>
				LinkedIn
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		background: #ffffff;
		border-bottom: 1px solid #e5e7eb;
		position: sticky;
		top: 0;
		z-index: 100;
	}

	nav {
		max-width: 1200px;
		margin: 0 auto;
		padding: 1rem 1.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
	}

	.logo {
		display: flex;
		flex-direction: column;
	}

	.logo h2 {
		margin: 0;
		font-size: 1.4rem;
		font-weight: 700;
	}

	.logo a {
		text-decoration: none;
		color: #0176d3;
	}

	.tagline {
		font-size: 0.75rem;
		color: #64748b;
	}

	.internal-links {
		display: flex;
		gap: 1rem;
	}

	.internal-links a {
		text-decoration: none;
		color: #334155;
		font-weight: 500;
		padding: 0.5rem;
		transition: all 0.2s ease;
	}

	.internal-links a:hover {
		color: #0176d3;
	}

	.internal-links a.active {
		color: #0176d3;
		border-bottom: 2px solid #0176d3;
	}

	.social-links {
		display: flex;
		gap: 1rem;
	}

	.social-links a {
		text-decoration: none;
		color: #64748b;
		font-size: 0.9rem;
		font-weight: 500;
	}

	.social-links a:hover {
		color: #0176d3;
	}

	@media (max-width: 768px) {
		nav {
			flex-direction: column;
			align-items: flex-start;
		}

		.internal-links {
			flex-wrap: wrap;
		}

		.social-links {
			display: none;
		}
	}
</style>
