---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { getCollection } from "astro:content";
import readingTime from "reading-time";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);

const postsWithTime = posts.map((post) => {
  const stats = readingTime(post.body || "");
  return {
    ...post,
    readingTime: stats.text,
  };
});
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section class="hero-section">
        <div class="hero-bg-blobs">
          <div class="blob blob-1"></div>
          <div class="blob blob-2"></div>
        </div>

        <div class="hero-content">
          <span class="badge">Salesforce Dev Hub</span>
          <h1>
            Master Salesforce <span class="gradient-text">Development</span>
          </h1>
          <p class="hero-description">
            Deep dives into Apex, Lightning Web Components, Agentforce, API
            Integrations, and advanced system architecture.
          </p>

          <div class="hero-search">
            <div class="search-wrapper">
              <svg
                class="search-icon"
                viewBox="0 0 24 24"
                width="18"
                height="18"
                stroke="currentColor"
                stroke-width="2.5"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><circle cx="11" cy="11" r="8"></circle><line
                  x1="21"
                  y1="21"
                  x2="16.65"
                  y2="16.65"></line></svg
              >
              <input
                type="search"
                id="home-search"
                placeholder="Search articles (e.g. Triggers, LWC, APIs...)"
                aria-label="Search articles"
              />
            </div>
          </div>

          <div class="hero-pills">
            <button class="pill active" data-category="all">All Topics</button>
            <button class="pill" data-category="Apex">Apex</button>
            <button class="pill" data-category="LWC">LWC</button>
            <button class="pill" data-category="Agentforce">Agentforce</button>
            <button class="pill" data-category="Integrations"
              >Integrations</button
            >
          </div>
        </div>
      </section>

      <section class="topics-section">
        <div class="section-header">
          <h2>Explore Core Topics</h2>
          <p>Deep-dive learning paths built for modern Salesforce engineers.</p>
        </div>

        <div class="topics-grid">
          <div class="topic-card">
            <div class="topic-icon apex">
              <svg
                viewBox="0 0 24 24"
                width="24"
                height="24"
                stroke="currentColor"
                stroke-width="2"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><polyline points="16 18 22 12 16 6"></polyline><polyline
                  points="8 6 2 12 8 18"></polyline></svg
              >
            </div>
            <h3>Apex Programming</h3>
            <p>
              Best practices, triggers, batch jobs, SOQL optimization, and
              advanced patterns.
            </p>
          </div>

          <div class="topic-card">
            <div class="topic-icon lwc">
              <svg
                viewBox="0 0 24 24"
                width="24"
                height="24"
                stroke="currentColor"
                stroke-width="2"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><rect x="2" y="3" width="20" height="14" rx="2" ry="2"
                ></rect><line x1="8" y1="21" x2="16" y2="21"></line><line
                  x1="12"
                  y1="17"
                  x2="12"
                  y2="21"></line></svg
              >
            </div>
            <h3>Lightning Components</h3>
            <p>
              Build custom modern frontends using the official LWC standard, JS,
              and CSS.
            </p>
          </div>

          <div class="topic-card">
            <div class="topic-icon agent">
              <svg
                viewBox="0 0 24 24"
                width="24"
                height="24"
                stroke="currentColor"
                stroke-width="2"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path
                  d="M12 2a10 10 0 0 1 7.54 16.59c-.24.25-.61.35-.95.24a9.99 9.99 0 0 1-13.18 0c-.34.11-.71.01-.95-.24A10 10 0 0 1 12 2z"
                ></path><path d="M12 18v4"></path><path
                  d="M4.93 19.07l2.83-2.83"></path><path
                  d="M19.07 19.07l-2.83-2.83"></path><circle
                  cx="12"
                  cy="10"
                  r="3"></circle></svg
              >
            </div>
            <h3>Agentforce & AI</h3>
            <p>
              Integrate conversational agents, AI guardrails, prompt templates,
              and reasoning models.
            </p>
          </div>

          <div class="topic-card">
            <div class="topic-icon integration">
              <svg
                viewBox="0 0 24 24"
                width="24"
                height="24"
                stroke="currentColor"
                stroke-width="2"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path
                  d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"
                ></path><path
                  d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"
                ></path></svg
              >
            </div>
            <h3>Integrations & APIs</h3>
            <p>
              Connect systems using REST APIs, custom webhooks, JWT
              authentication, and callouts.
            </p>
          </div>
        </div>
      </section>

      <div class="site-layout-grid">
        <!-- Main Content Left (70%) -->
        <div class="main-content-flow">
          <section class="articles-section">
            <div class="section-header">
              <h2>Latest Publications</h2>
              <p>
                Stay up to date with the latest developer guides and articles.
              </p>
            </div>
            <div class="articles-grid" id="articles-container">
              {
                postsWithTime.slice(1).map((post) => (
                  <article
                    class="article-card"
                    data-title={post.data.title.toLowerCase()}
                    data-desc={post.data.description.toLowerCase()}
                    data-category={post.data.category || ""}
                  >
                    <div class="card-header">
                      {post.data.category && (
                        <a
                          href={`${import.meta.env.BASE_URL}/blog/categories/${post.data.category.toLowerCase().replace(/\s+/g, "-")}`}
                          class={`tag-badge ${post.data.category.toLowerCase().replace(/\s+/g, "-")}`}
                        >
                          {post.data.category}
                        </a>
                      )}
                      <span class="read-time-badge">{post.readingTime}</span>
                    </div>

                    <div class="card-body">
                      <h3>
                        <a
                          href={`${import.meta.env.BASE_URL}/blog/${post.id.replace("/index", "")}/`}
                        >
                          {post.data.title}
                        </a>
                      </h3>
                      <p>{post.data.description}</p>
                    </div>

                    <div class="card-footer">
                      <div class="author-info">
                        <div class="author-avatar">
                          {post.data.author ? post.data.author.charAt(0) : "J"}
                        </div>
                        <span class="author-name">
                          {post.data.author || "Juned Khan"}
                        </span>
                      </div>
                      <a
                        href={`${import.meta.env.BASE_URL}/blog/${post.id.replace("/index", "")}/`}
                        class="read-more-link"
                      >
                        Read →
                      </a>
                    </div>
                  </article>
                ))
              }
            </div>

            <div class="no-results" id="no-results-msg">
              <svg
                viewBox="0 0 24 24"
                width="48"
                height="48"
                stroke="currentColor"
                stroke-width="1.5"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><circle cx="11" cy="11" r="8"></circle><line
                  x1="21"
                  y1="21"
                  x2="16.65"
                  y2="16.65"></line><line x1="8" y1="11" x2="14" y2="11"
                ></line></svg
              >
              <h3>No articles found</h3>
              <p>Try searching for a different keyword or category.</p>
            </div>
          </section>
        </div>

        <!-- Sidebar Content Right (30%) -->
        <Sidebar />
      </div>
    </main>
    <Footer />

    <script>
      const searchInput = document.getElementById(
        "home-search",
      ) as HTMLInputElement;
      const pills = document.querySelectorAll(".hero-pills .pill");
      const articles = document.querySelectorAll(
        "#articles-container .article-card, .featured-card",
      ) as NodeListOf<HTMLElement>;
      const noResults = document.getElementById(
        "no-results-msg",
      ) as HTMLElement;

      let activeCategory = "all";
      let searchQuery = "";

      function filterArticles() {
        let visibleCount = 0;

        articles.forEach((article) => {
          const title = article.getAttribute("data-title") || "";
          const desc = article.getAttribute("data-desc") || "";
          const category = article.getAttribute("data-category") || "";

          const matchesSearch =
            title.includes(searchQuery) || desc.includes(searchQuery);
          const matchesCategory =
            activeCategory === "all" ||
            category.toLowerCase() === activeCategory.toLowerCase();

          if (matchesSearch && matchesCategory) {
            article.style.display = "flex";
            visibleCount++;
          } else {
            article.style.display = "none";
          }
        });

        if (visibleCount === 0) {
          noResults.style.display = "flex";
        } else {
          noResults.style.display = "none";
        }
      }

      if (searchInput) {
        searchInput.addEventListener("input", (e) => {
          searchQuery = (e.target as HTMLInputElement).value
            .toLowerCase()
            .trim();
          filterArticles();
        });
      }

      pills.forEach((pill) => {
        pill.addEventListener("click", (e) => {
          pills.forEach((p) => p.classList.remove("active"));
          const target = e.currentTarget as HTMLElement;
          target.classList.add("active");
          activeCategory = target.getAttribute("data-category") || "all";
          filterArticles();
        });
      });
    </script>
  </body>
</html>

<style>
  /* Hero Section Styling */
  .hero-section {
    position: relative;
    padding: 6rem 1rem 5rem;
    text-align: center;
    border-bottom: 1px solid var(--border-color);
    margin-bottom: 4rem;
  }

  .hero-bg-blobs {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
    z-index: -1;
    pointer-events: none;
  }

  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.12;
  }

  .blob-1 {
    width: 350px;
    height: 350px;
    background: #0176d3;
    top: -50px;
    left: 10%;
  }

  .blob-2 {
    width: 300px;
    height: 300px;
    background: #00b4d8;
    bottom: -50px;
    right: 15%;
  }

  .hero-content {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .badge {
    background-color: var(--bg-tertiary);
    color: var(--accent);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.4rem 1rem;
    border-radius: 99px;
    border: 1px solid var(--border-color);
    margin-bottom: 1.5rem;
  }

  .hero-section h1 {
    font-size: clamp(2.5rem, 6vw, 3.75rem);
    line-height: 1.15;
    margin-bottom: 1.25rem;
    letter-spacing: -0.03em;
    font-weight: 800;
  }

  .hero-description {
    font-size: 1.15rem;
    line-height: 1.75;
    color: var(--text-secondary);
    max-width: 650px;
    margin-bottom: 2rem;
  }

  /* Search bar */
  .hero-search {
    width: 100%;
    max-width: 520px;
    margin-bottom: 2rem;
  }

  .search-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 1.25rem;
    color: var(--text-muted);
    pointer-events: none;
  }

  .search-wrapper input {
    width: 100%;
    padding: 1rem 1rem 1rem 3.25rem;
    font-size: 1rem;
    border: 1px solid var(--border-color);
    border-radius: 99px;
    background-color: var(--bg-secondary);
    color: var(--text-primary);
    box-shadow: var(--shadow-sm);
    transition: all 0.25s ease;
    outline: none;
  }

  .search-wrapper input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 4px rgba(1, 118, 211, 0.15);
  }

  /* Pills */
  .hero-pills {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .pill {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    padding: 0.5rem 1.2rem;
    border-radius: 99px;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .pill:hover {
    border-color: var(--accent);
    color: var(--accent);
    background-color: var(--bg-tertiary);
    transform: translateY(-1px);
  }

  .pill.active {
    background-color: var(--accent);
    color: #ffffff;
    border-color: var(--accent);
  }

  /* Topics Section */
  .topics-section {
    margin-bottom: 5rem;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-header h2 {
    font-size: 1.85rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .section-header p {
    color: var(--text-muted);
    font-size: 1rem;
  }

  .topics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  .topic-card {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 2rem 1.5rem;
    transition: all 0.25s ease;
  }

  .topic-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--accent);
  }

  .topic-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .topic-icon.apex {
    background: rgba(1, 118, 211, 0.1);
    color: #0176d3;
  }
  .topic-icon.lwc {
    background: rgba(16, 185, 129, 0.1);
    color: #10b981;
  }
  .topic-icon.agent {
    background: rgba(139, 92, 246, 0.1);
    color: #8b5cf6;
  }
  .topic-icon.integration {
    background: rgba(245, 158, 11, 0.1);
    color: #f59e0b;
  }

  .topic-card h3 {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }

  .topic-card p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 0;
    line-height: 1.6;
  }

  /* Publications Section */
  .articles-section {
    margin-bottom: 5rem;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.75rem;
  }

  .article-card {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    transition: all 0.25s ease;
  }

  .article-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
    border-color: var(--accent);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .tag-badge {
    padding: 0.25rem 0.75rem;
    border-radius: 99px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
  }

  /* Tech colors */
  .tag-badge.apex {
    background-color: rgba(1, 118, 211, 0.1);
    color: #0176d3;
  }
  .tag-badge.lwc {
    background-color: rgba(16, 185, 129, 0.1);
    color: #10b981;
  }
  .tag-badge.agentforce {
    background-color: rgba(139, 92, 246, 0.1);
    color: #8b5cf6;
  }
  .tag-badge.integrations {
    background-color: rgba(245, 158, 11, 0.1);
    color: #f59e0b;
  }
  .tag-badge.salesforce-dev-notes {
    background-color: rgba(79, 70, 229, 0.1);
    color: #4f46e5;
  }

  .read-time-badge {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .card-body {
    flex: 1;
  }

  .card-body h3 {
    font-size: 1.35rem;
    line-height: 1.3;
    margin-bottom: 0.75rem;
  }

  .card-body h3 a {
    color: var(--text-primary);
    text-decoration: none;
  }

  .card-body h3 a:hover {
    color: var(--accent);
  }

  .card-body p {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border-color);
    padding-top: 1.25rem;
    margin-top: auto;
  }

  .author-info {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .author-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--accent-gradient);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.8rem;
  }

  .author-name {
    font-size: 0.85rem;
    color: var(--text-primary);
    font-weight: 600;
  }

  .read-more-link {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--accent);
    display: flex;
    align-items: center;
    gap: 0.25rem;
    text-decoration: none;
  }

  .read-more-link:hover {
    color: var(--accent-hover);
    transform: translateX(3px);
  }

  /* Search No Results Message */
  .no-results {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem 1rem;
    text-align: center;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 16px;
  }

  .no-results svg {
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .no-results h3 {
    font-size: 1.25rem;
    margin-bottom: 0.25rem;
  }

  .no-results p {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 0;
  }

  /* Newsletter Banner */
  .newsletter-section {
    border-radius: 20px;
    padding: 3rem 2rem;
    text-align: center;
    position: relative;
    overflow: hidden;
    margin-top: 2rem;
  }

  .newsletter-content {
    max-width: 600px;
    margin: 0 auto;
  }

  .newsletter-content h2 {
    font-size: 1.75rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
  }

  .newsletter-content p {
    color: var(--text-secondary);
    font-size: 1rem;
    margin-bottom: 1.75rem;
  }

  .newsletter-form {
    display: flex;
    gap: 0.5rem;
    max-width: 480px;
    margin: 0 auto;
  }

  .newsletter-form input {
    flex: 1;
    padding: 0.75rem 1.25rem;
    font-size: 0.95rem;
    border: 1px solid var(--border-color);
    border-radius: 10px;
    outline: none;
    background-color: var(--bg-secondary);
    color: var(--text-primary);
  }

  .newsletter-form input:focus {
    border-color: var(--accent);
  }

  .btn-subscribe {
    background-color: var(--accent);
    color: #ffffff;
    border: none;
    padding: 0.75rem 1.5rem;
    font-size: 0.95rem;
    font-weight: 700;
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-subscribe:hover {
    background-color: var(--accent-hover);
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .hero-section {
      padding: 4rem 1rem 3rem;
    }

    .newsletter-form {
      flex-direction: column;
    }

    .btn-subscribe {
      width: 100%;
    }
  }

  /* Featured Card Redesign */
  .featured-card {
    display: flex;
    flex-direction: column;
    border-radius: 24px;
    overflow: hidden;
    margin-bottom: 3rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border: 1px solid var(--border-color);
    text-decoration: none;
  }

  .featured-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
    border-color: var(--accent);
  }

  .featured-img-container {
    position: relative;
    width: 100%;
    height: 280px;
    overflow: hidden;
  }

  .featured-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .featured-card:hover .featured-img {
    transform: scale(1.03);
  }

  .featured-category-badge {
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    z-index: 10;
    box-shadow: var(--shadow-sm);
  }

  .featured-card-body {
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: var(--bg-secondary);
  }

  .featured-meta {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .featured-card-body h3 {
    font-size: 1.85rem;
    line-height: 1.25;
    margin-bottom: 0;
  }

  .featured-card-body h3 a {
    color: var(--text-primary);
    text-decoration: none;
  }

  .featured-card-body h3 a:hover {
    color: var(--accent);
  }

  .featured-card-body p {
    color: var(--text-secondary);
