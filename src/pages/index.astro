---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<main>
				<section class="hero">
					<h1>Salesforce Dev Notes</h1>

					<p class="hero-description">
						Practical Salesforce tutorials, Apex guides, Lightning
						Web Components, Agentforce, integrations, and real-world
						development tips.
					</p>

					<div class="hero-buttons">
						<a href="/astro-blog/blog" class="btn-primary">Read Articles</a>
						<a href="/astro-blog/about" class="btn-secondary">About Me</a>
					</div>
				</section>

				<section class="categories">
					<h2>Explore Topics</h2>

					<div class="category-grid">
						<div class="card">
							<h3>Apex</h3>
							<p>
								Triggers, Classes, SOQL, Batch Apex and Best
								Practices.
							</p>
						</div>

						<div class="card">
							<h3>LWC</h3>
							<p>
								Lightning Web Components from beginner to
								advanced.
							</p>
						</div>

						<div class="card">
							<h3>Agentforce</h3>
							<p>Build AI-powered Salesforce solutions.</p>
						</div>

						<div class="card">
							<h3>Integrations</h3>
							<p>
								REST APIs, Webhooks, Named Credentials and more.
							</p>
						</div>
					</div>
				</section>

				<section class="featured">
					<h2>Featured Articles</h2>

					<div class="article-grid">
						<div class="article-card">
							<h3>What is Salesforce?</h3>
							<p>
								A beginner-friendly introduction to the
								Salesforce platform.
							</p>
						</div>

						<div class="article-card">
							<h3>Understanding Apex Triggers</h3>
							<p>Learn how triggers work and when to use them.</p>
						</div>

						<div class="article-card">
							<h3>Introduction to Lightning Web Components</h3>
							<p>Build modern user interfaces on Salesforce.</p>
						</div>
					</div>
				</section>

				<section class="about-preview">
					<h2>About This Blog</h2>

					<p>
						I'm Juned, a Salesforce Developer passionate about
						sharing practical tutorials, coding examples, system
						design concepts, and lessons learned from real-world
						Salesforce projects.
					</p>
				</section>
			</main>
		</main>
		<Footer />
	</body>
</html>
<style>
	main {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2rem;
	}

	.hero {
		text-align: center;
		padding: 5rem 0;
	}

	.hero h1 {
		font-size: 3rem;
		margin-bottom: 1rem;
		color: #0176d3;
	}

	.hero-description {
		font-size: 1.2rem;
		max-width: 700px;
		margin: 0 auto 2rem;
		color: #64748b;
	}

	.hero-buttons {
		display: flex;
		justify-content: center;
		gap: 1rem;
	}

	.btn-primary,
	.btn-secondary {
		padding: 0.8rem 1.5rem;
		border-radius: 8px;
		text-decoration: none;
		font-weight: 600;
	}

	.btn-primary {
		background: #0176d3;
		color: white;
	}

	.btn-secondary {
		border: 1px solid #cbd5e1;
		color: #334155;
	}

	.categories,
	.featured,
	.about-preview {
		margin-top: 5rem;
	}

	.category-grid,
	.article-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 1.5rem;
		margin-top: 2rem;
	}

	.card,
	.article-card {
		padding: 1.5rem;
		border: 1px solid #e2e8f0;
		border-radius: 12px;
		background: white;
		transition: transform 0.2s;
	}

	.card:hover,
	.article-card:hover {
		transform: translateY(-4px);
	}

	.about-preview {
		text-align: center;
		max-width: 700px;
		margin-left: auto;
		margin-right: auto;
	}
</style>
