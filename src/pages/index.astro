---
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import { POSTS_PER_PAGE, SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import BlogList from "../components/BlogList.astro";

const allPosts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const posts = allPosts.slice(0, POSTS_PER_PAGE);
const totalPages = Math.ceil(allPosts.length / POSTS_PER_PAGE);

// Get all unique categories for dynamic filter pills
const predefined = ["Apex", "LWC", "Agentforce", "Integrations", "Salesforce Dev Notes"];
const postCategories = allPosts.map(post => post.data.category).filter(Boolean) as string[];
const categories = [...new Set([...predefined, ...postCategories])].sort();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="blog-header">
				<h1>Salesforce Publications</h1>
				<p>Practical guides, Apex architecture, Lightning Web Components, and integrations.</p>

				<div class="search-filters">
					<div class="search-wrapper">
						<svg class="search-icon" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
						<input
							type="search"
							id="blog-search"
							placeholder="Search through current page..."
							aria-label="Search articles"
						/>
					</div>
					<div class="filter-pills">
						<a href={`${import.meta.env.BASE_URL}/`} class="pill active">All</a>
						{
							categories.map((cat) => {
								const catSlug = cat!.toLowerCase().replace(/\s+/g, "-");
								return (
									<a
										href={`${import.meta.env.BASE_URL}/blog/categories/${catSlug}`}
										class="pill"
									>
										{cat}
									</a>
								);
							})
						}
					</div>
				</div>
			</section>

			<div class="site-layout-grid">
				<div class="main-content-flow">
					<div class="blog-list-container">
						<BlogList posts={posts} />
						
						<div class="no-results" id="no-results-msg">
							<svg viewBox="0 0 24 24" width="48" height="48" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
							<h3>No articles found</h3>
							<p>Try searching for a different keyword or category on this page.</p>
						</div>
					</div>

					{totalPages > 1 && (
						<nav class="pagination">
							<a href={`${import.meta.env.BASE_URL}/blog/page/2`} class="btn-pagination">
								Next Page →
							</a>
						</nav>
					)}
				</div>
				<Sidebar />
			</div>
		</main>
		<Footer />

		<script>
			const searchInput = document.getElementById("blog-search") as HTMLInputElement;
			const articles = document.querySelectorAll(".articles-grid .article-card") as NodeListOf<HTMLElement>;
			const noResults = document.getElementById("no-results-msg") as HTMLElement;

			let searchQuery = "";

			function filterArticles() {
				let visibleCount = 0;

				articles.forEach((article) => {
					const title = article.getAttribute("data-title") || "";
					const desc = article.getAttribute("data-desc") || "";

					const matchesSearch = title.includes(searchQuery) || desc.includes(searchQuery);

					if (matchesSearch) {
						article.style.display = "flex";
						visibleCount++;
					} else {
						article.style.display = "none";
					}
				});

				if (visibleCount === 0) {
					noResults.style.display = "flex";
				} else {
					noResults.style.display = "none";
				}
			}

			if (searchInput) {
				searchInput.addEventListener("input", (e) => {
					searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
					filterArticles();
				});
			}
		</script>
	</body>
</html>

<style>
	main {
		max-width: 1000px;
		margin: 0 auto;
		padding: 3rem 1.5rem;
	}

	.blog-header {
		text-align: center;
		margin-bottom: 4rem;
	}

	.blog-header h1 {
		font-size: 2.75rem;
		font-weight: 800;
		letter-spacing: -0.025em;
		margin-bottom: 0.75rem;
	}

	.blog-header p {
		color: var(--text-secondary);
		font-size: 1.1rem;
		max-width: 650px;
		margin: 0 auto 2.5rem;
	}

	/* Search and Filters */
	.search-filters {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
		width: 100%;
		max-width: 600px;
		margin: 0 auto;
	}

	.search-wrapper {
		position: relative;
		display: flex;
		align-items: center;
		width: 100%;
	}

	.search-icon {
		position: absolute;
		left: 1.25rem;
		color: var(--text-muted);
		pointer-events: none;
	}

	.search-wrapper input {
		width: 100%;
		padding: 0.9rem 1.25rem 0.9rem 3.25rem;
		font-size: 0.95rem;
		border: 1px solid var(--border-color);
		border-radius: 99px;
		background-color: var(--bg-secondary);
		color: var(--text-primary);
		box-shadow: var(--shadow-sm);
		transition: all 0.25s ease;
		outline: none;
	}

	.search-wrapper input:focus {
		border-color: var(--accent);
		box-shadow: 0 0 0 4px rgba(1, 118, 211, 0.15);
	}

	/* Pills */
	.filter-pills {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
		justify-content: center;
	}

	.pill {
		background-color: var(--bg-secondary);
		border: 1px solid var(--border-color);
		color: var(--text-secondary);
		padding: 0.4rem 1rem;
		border-radius: 99px;
		font-size: 0.85rem;
		font-weight: 600;
		cursor: pointer;
		transition: all 0.2s ease;
		text-decoration: none;
	}

	.pill:hover {
		border-color: var(--accent);
		color: var(--accent);
		background-color: var(--bg-tertiary);
		transform: translateY(-1px);
	}

	.pill.active {
		background-color: var(--accent);
		color: #ffffff;
		border-color: var(--accent);
	}

	/* No Results */
	.no-results {
		display: none;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 4rem 1rem;
		text-align: center;
		background-color: var(--bg-secondary);
		border: 1px solid var(--border-color);
		border-radius: 16px;
		margin-top: 2rem;
	}

	.no-results svg {
		color: var(--text-muted);
		margin-bottom: 1rem;
	}

	.no-results h3 {
		font-size: 1.25rem;
		margin-bottom: 0.25rem;
	}

	.no-results p {
		color: var(--text-muted);
		font-size: 0.9rem;
		margin-bottom: 0;
	}

	/* Pagination */
	.pagination {
		display: flex;
		justify-content: center;
		margin-top: 4rem;
	}

	.btn-pagination {
		background-color: var(--bg-secondary);
		color: var(--text-primary);
		border: 1px solid var(--border-color);
		padding: 0.75rem 1.5rem;
		border-radius: 12px;
		font-weight: 700;
		font-size: 0.95rem;
		transition: all 0.2s ease;
		box-shadow: var(--shadow-sm);
		text-decoration: none;
	}

	.btn-pagination:hover {
		background-color: var(--bg-tertiary);
		border-color: var(--accent);
		color: var(--accent);
		transform: translateY(-2px);
		box-shadow: var(--shadow-md);
	}

	@media (max-width: 640px) {
		.blog-header h1 {
			font-size: 2.25rem;
		}
	}
</style>
