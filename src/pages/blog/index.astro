---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Header from "../../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
console.log("Posts:", posts);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				max-width: 1000px;
				margin: 0 auto;
				padding: 2rem;
			}

			.hero {
				text-align: center;
				padding: 4rem 0;
				margin-bottom: 3rem;
			}

			.hero h1 {
				font-size: 3rem;
				color: #0176d3;
				margin-bottom: 1rem;
			}

			.hero p {
				font-size: 1.1rem;
				color: #64748b;
				max-width: 700px;
				margin: 0 auto;
			}

			.articles {
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
			}

			.article-card {
				border: 1px solid #e2e8f0;
				border-radius: 12px;
				padding: 1.5rem;
				background: white;
				transition: all 0.2s ease;
			}

			.article-card:hover {
				transform: translateY(-3px);
				box-shadow: 0 10px 20px rgba(0, 0, 0, 0.05);
			}

			.article-card a {
				text-decoration: none;
			}

			.article-card h2 {
				margin: 0;
				color: #0f172a;
				font-size: 1.5rem;
			}

			.article-card:hover h2 {
				color: #0176d3;
			}

			.description {
				margin-top: 0.75rem;
				color: #64748b;
				line-height: 1.7;
			}

			.meta {
				margin-top: 1rem;
				font-size: 0.9rem;
				color: #94a3b8;
			}
			.category {
				display: inline-block;
				background: #e0f2fe;
				color: #0369a1;
				padding: 0.25rem 0.75rem;
				border-radius: 999px;
				font-size: 0.8rem;
				font-weight: 600;
				margin-bottom: 1rem;
			}

			@media (max-width: 768px) {
				.hero h1 {
					font-size: 2rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Salesforce Articles</h1>

				<p>
					Practical tutorials on Apex, Lightning Web Components,
					Agentforce, Integrations, and Salesforce best practices.
				</p>
			</section>

			<section class="articles">
				{
					// posts.map((post) => (
					// 	<article class="article-card">
					// 		<a href={`/blog/${post.id}/`}>
					// 			<h2>{post.data.title}</h2>

					// 			<p class="description">
					// 				{post.data.description}
					// 			</p>

					// 			<div class="meta">
					// 				<FormattedDate date={post.data.pubDate} />
					// 			</div>
					// 		</a>
					// 	</article>
					// 	<span class="category">
					// 		{post.data.category}
					// 	</span>
					// ))
					posts.map((post) => (
						<article class="article-card">
							{/* <a href={`/blog/${post.id}/`}> */}
							<a href={`/astro-blog/blog/${post.id.replace('/index', '')}/`}>
							
								<h2>{post.data.title}</h2>

								<p>{post.data.description}</p>
							</a>
						</article>
					))
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
