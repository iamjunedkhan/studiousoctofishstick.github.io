---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";

type Props = CollectionEntry<"blog">["data"];

// const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	category,
	author,
} = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				max-width: 1200px;
				margin: 0 auto;
				padding: 2rem;
			}

			.article-header {
				text-align: center;
				max-width: 900px;
				margin: 0 auto 3rem;
			}

			.category-badge {
				display: inline-block;
				padding: 0.4rem 1rem;
				border-radius: 999px;
				background: #e0f2fe;
				color: #0369a1;
				font-size: 0.85rem;
				font-weight: 600;
				margin-bottom: 1rem;
			}

			.article-header h1 {
				font-size: 3rem;
				line-height: 1.2;
				margin-bottom: 1rem;
				color: #0f172a;
			}

			.article-description {
				font-size: 1.2rem;
				color: #64748b;
				max-width: 700px;
				margin: auto;
			}

			.meta {
				display: flex;
				justify-content: center;
				gap: 0.75rem;
				margin-top: 1.5rem;
				color: #94a3b8;
				font-size: 0.9rem;
			}

			.hero-image {
				margin: 3rem auto;
				max-width: 1000px;
			}

			.hero-image img {
				width: 100%;
				border-radius: 16px;
				box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
			}

			.prose {
				max-width: 800px;
				margin: auto;
				font-size: 1.1rem;
				line-height: 1.9;
				color: #334155;
			}

			.prose h2 {
				margin-top: 3rem;
				color: #0176d3;
			}

			.prose h3 {
				margin-top: 2rem;
			}

			.prose pre {
				border-radius: 12px;
				padding: 1rem;
				overflow-x: auto;
				margin: 2rem 0;
			}

			.prose blockquote {
				border-left: 4px solid #0176d3;
				padding-left: 1rem;
				color: #64748b;
				margin: 2rem 0;
			}

			.prose img {
				border-radius: 12px;
				margin: 2rem auto;
			}

			.author-card {
				max-width: 800px;
				margin: 5rem auto;
				padding: 2rem;
				background: #f8fafc;
				border-radius: 16px;
				border: 1px solid #e2e8f0;
			}

			.author-card h3 {
				margin-top: 0;
				color: #0176d3;
			}

			@media (max-width: 768px) {
				.article-header h1 {
					font-size: 2rem;
				}

				.meta {
					flex-wrap: wrap;
				}

				.prose {
					font-size: 1rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<header class="article-header">
					<div class="category-badge">
						{category}
					</div>

					<h1>{title}</h1>

					<p class="article-description">
						{description}
					</p>

					<div class="meta">
						<span>
							<FormattedDate date={pubDate} />
						</span>

						<span>•</span>

						<span>{author}</span>

						{
							updatedDate && (
								<>
									<span>•</span>
									<span>
										Updated{" "}
										<FormattedDate date={updatedDate} />
									</span>
								</>
							)
						}
					</div>
				</header>

				{
					heroImage && (
						<div class="hero-image">
							<Image
								src={heroImage}
								alt={title}
								width={1200}
								height={600}
							/>
						</div>
					)
				}

				<div class="prose">
					<slot />
				</div>

				<section class="author-card">
					<h3>About the Author</h3>

					<p>
						Juned Khan is a Salesforce Developer passionate about
						Apex, Lightning Web Components, Agentforce,
						Integrations, and sharing practical development
						knowledge with the Salesforce community.
					</p>
				</section>
			</article>
		</main>
		<Footer />
	</body>
</html>
