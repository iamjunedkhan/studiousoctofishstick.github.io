---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import readingTime from "reading-time";

type Props = CollectionEntry<"blog">["data"] & { body?: string };

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	category,
	author,
	body = "",
} = Astro.props;

// Calculate reading time
const rTimeStats = readingTime(body);
const readingTimeText = rTimeStats.text;

// Retrieve related posts (same category, different title)
const allPosts = await getCollection("blog");
let relatedPosts = allPosts.filter(
	(p) => p.data.title !== title && p.data.category === category
);

if (relatedPosts.length === 0) {
	relatedPosts = allPosts.filter((p) => p.data.title !== title).slice(0, 2);
} else {
	relatedPosts = relatedPosts.slice(0, 2);
}
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		
		<div id="reading-progress-bar" class="reading-progress"></div>

		<main class="article-container">
			<article class="prose-layout">
				<header class="article-header">
					<div class="header-meta">
						<span class={`category-badge ${category?.toLowerCase() || ''}`}>{category}</span>
						<span class="read-time">• {readingTimeText}</span>
					</div>

					<h1>{title}</h1>
					<p class="subtitle-desc">{description}</p>

					<div class="author-bar">
						<div class="author-avatar">{author ? author.charAt(0) : "J"}</div>
						<div class="author-details">
							<span class="author-name">{author || "Juned Khan"}</span>
							<span class="publish-dates">
								Published <FormattedDate date={pubDate} />
								{
									updatedDate && (
										<>
											{" "}
											(Updated <FormattedDate date={updatedDate} />)
										</>
									)
								}
							</span>
						</div>
					</div>
				</header>

				{
					heroImage && (
						<div class="hero-image-container">
							<Image
								src={heroImage}
								alt={title}
								width={1200}
								height={600}
								class="hero-img"
							/>
						</div>
					)
				}

				<hr class="divider" />

				<div class="article-body">
					<slot />
				</div>

				<hr class="divider" />

				<footer class="article-footer">
					<div class="share-section">
						<span class="share-label">Share Article:</span>
						<div class="share-buttons">
							<button id="share-x" class="share-btn" aria-label="Share on X">
								<svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4l11.733 16h4.267l-11.733 -16z"></path><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"></path></svg>
							</button>
							<button id="share-linkedin" class="share-btn" aria-label="Share on LinkedIn">
								<svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
							</button>
							<button id="share-copy" class="share-btn" aria-label="Copy Link">
								<svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
							</button>
						</div>
					</div>
				</footer>

				<!-- Newsletter Box -->
				<section class="post-newsletter glass">
					<h3>Enjoyed this post?</h3>
					<p>Subscribe to our newsletter and never miss Salesforce triggers, LWC, or integration tips!</p>
					<form class="newsletter-form" onsubmit="event.preventDefault(); alert('Subscribed! (Simulated)'); this.reset();">
						<input type="email" placeholder="Your email address" required aria-label="Email Address" />
						<button type="submit">Subscribe</button>
					</form>
				</section>

				<!-- Author Card -->
				<section class="about-author-card glass">
					<div class="author-avatar large">{author ? author.charAt(0) : "J"}</div>
					<div class="author-bio">
						<h3>About the Author</h3>
						<p>
							{author || "Juned Khan"} is a Salesforce Developer and Technical Writer who specializes in Apex, LWC, Agentforce, API Integrations, and Salesforce system design. Passionate about helping other developers excel in their Salesforce careers.
						</p>
					</div>
				</section>
			</article>

			<!-- Related Posts -->
			{relatedPosts.length > 0 && (
				<section class="related-posts-section">
					<h2>Related Publications</h2>
					<div class="related-posts-grid">
						{relatedPosts.map((rPost) => (
							<a href={`${import.meta.env.BASE_URL}/blog/${rPost.id.replace("/index", "")}/`} class="related-card glass">
								<span class={`tag-badge ${rPost.data.category?.toLowerCase() || ''}`}>{rPost.data.category}</span>
								<h3>{rPost.data.title}</h3>
								<p>{rPost.data.description}</p>
								<span class="read-link">Read Article →</span>
							</a>
						))}
					</div>
				</section>
			)}
		</main>

		<Footer />

		<!-- Reading progress bar script -->
		<script>
			window.addEventListener('scroll', () => {
				const progressBar = document.getElementById('reading-progress-bar');
				if (progressBar) {
					const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
					const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
					const scrolled = (winScroll / height) * 100;
					progressBar.style.width = scrolled + '%';
				}
			});
		</script>

		<!-- Copy code block script -->
		<script>
			const blocks = document.querySelectorAll('pre');
			
			blocks.forEach((block) => {
				const button = document.createElement('button');
				button.className = 'copy-code-btn';
				button.type = 'button';
				button.ariaLabel = 'Copy code';
				button.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="copy-icon"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
				
				block.style.position = 'relative';
				block.appendChild(button);
				
				button.addEventListener('click', async () => {
					const code = block.querySelector('code');
					const text = code ? code.innerText : '';
					
					try {
						await navigator.clipboard.writeText(text);
						button.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg>';
						button.classList.add('copied');
						
						setTimeout(() => {
							button.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="copy-icon"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
							button.classList.remove('copied');
						}, 2000);
					} catch (err) {
						console.error('Failed to copy: ', err);
					}
				});
			});
		</script>

		<!-- Share Buttons Script -->
		<script>
			const shareBtnCopy = document.getElementById('share-copy');
			const shareBtnX = document.getElementById('share-x');
			const shareBtnLinkedin = document.getElementById('share-linkedin');

			const pageUrl = window.location.href;
			const pageTitle = document.title;

			if (shareBtnCopy) {
				shareBtnCopy.addEventListener('click', async () => {
					try {
						await navigator.clipboard.writeText(pageUrl);
						alert('Link copied to clipboard!');
					} catch (err) {
						console.error(err);
					}
				});
			}

			if (shareBtnX) {
				shareBtnX.addEventListener('click', () => {
					window.open(`https://twitter.com/intent/tweet?text=${encodeURIComponent(pageTitle)}&url=${encodeURIComponent(pageUrl)}`, '_blank');
				});
			}

			if (shareBtnLinkedin) {
				shareBtnLinkedin.addEventListener('click', () => {
					window.open(`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`, '_blank');
				});
			}
		</script>
	</body>
</html>

<style>
	/* Reading progress bar */
	.reading-progress {
		position: fixed;
		top: 0;
		left: 0;
		width: 0%;
		height: 4px;
		background: var(--accent-gradient);
		z-index: 1001;
		transition: width 0.1s ease;
	}

	.article-container {
		max-width: 900px;
		margin: 0 auto;
		padding: 3rem 1.5rem;
	}

	.prose-layout {
		background-color: var(--bg-secondary);
		border: 1px solid var(--border-color);
		border-radius: 24px;
		padding: 3rem;
		box-shadow: var(--shadow-sm);
		transition: all 0.3s ease;
	}

	.article-header {
		margin-bottom: 2.5rem;
	}

	.header-meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 1.25rem;
	}

	.category-badge {
		padding: 0.3rem 0.9rem;
		border-radius: 99px;
		font-size: 0.775rem;
		font-weight: 700;
		text-transform: uppercase;
		display: inline-block;
	}

	.category-badge.apex { background-color: rgba(1, 118, 211, 0.1); color: #0176d3; }
	.category-badge.lwc { background-color: rgba(16, 185, 129, 0.1); color: #10b981; }
	.category-badge.agentforce { background-color: rgba(139, 92, 246, 0.1); color: #8b5cf6; }
	.category-badge.integrations { background-color: rgba(245, 158, 11, 0.1); color: #f59e0b; }

	.read-time {
		font-size: 0.85rem;
		color: var(--text-muted);
		font-weight: 500;
	}

	.article-header h1 {
		font-size: clamp(2rem, 5vw, 3rem);
		letter-spacing: -0.03em;
		font-weight: 800;
		line-height: 1.15;
		margin-bottom: 1rem;
	}

	.subtitle-desc {
		font-size: 1.15rem;
		line-height: 1.6;
		color: var(--text-secondary);
		margin-bottom: 2rem;
	}

	.author-bar {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		border-top: 1px solid var(--border-color);
		border-bottom: 1px solid var(--border-color);
		padding: 1rem 0;
	}

	.author-avatar {
		width: 40px;
		height: 40px;
		border-radius: 50%;
		background: var(--accent-gradient);
		color: #ffffff;
		display: flex;
		align-items: center;
		justify-content: center;
		font-weight: 700;
		font-size: 1rem;
	}

	.author-avatar.large {
		width: 60px;
		height: 60px;
		font-size: 1.5rem;
	}

	.author-details {
		display: flex;
		flex-direction: column;
	}

	.author-name {
		font-weight: 700;
		font-size: 0.95rem;
		color: var(--text-primary);
		line-height: 1.3;
	}

	.publish-dates {
		font-size: 0.8rem;
		color: var(--text-muted);
	}

	.hero-image-container {
		margin: 2rem -3rem;
		overflow: hidden;
	}

	.hero-img {
		width: 100%;
		height: auto;
		display: block;
		object-fit: cover;
	}

	.divider {
		border: none;
		border-top: 1px solid var(--border-color);
		margin: 2rem 0;
	}

	/* Main prose body styling */
	.article-body {
		color: var(--text-secondary);
		font-size: 1.05rem;
		line-height: 1.8;
	}

	.article-body :global(p) {
		margin-bottom: 1.5rem;
	}

	.article-body :global(h2) {
		font-size: 1.65rem;
		letter-spacing: -0.02em;
		margin-top: 2.5rem;
		margin-bottom: 1rem;
		font-weight: 800;
	}

	.article-body :global(h3) {
		font-size: 1.3rem;
		margin-top: 2rem;
		margin-bottom: 0.75rem;
		font-weight: 700;
	}

	.article-body :global(ul), .article-body :global(ol) {
		margin-bottom: 1.5rem;
		padding-left: 1.5rem;
	}

	.article-body :global(li) {
		margin-bottom: 0.5rem;
	}

	.article-body :global(blockquote) {
		border-left: 4px solid var(--accent);
		padding: 0.5rem 0 0.5rem 1.5rem;
		margin: 1.75rem 0;
		font-style: italic;
		color: var(--text-muted);
		background-color: var(--bg-tertiary);
		border-radius: 0 12px 12px 0;
	}

	.article-body :global(img) {
		border-radius: 12px;
		margin: 2rem auto;
		display: block;
		max-width: 100%;
		height: auto;
		box-shadow: var(--shadow-sm);
	}

	/* Inline Copy button styling */
	:global(pre) :global(.copy-code-btn) {
		position: absolute;
		top: 10px;
		right: 10px;
		background-color: var(--bg-secondary);
		border: 1px solid var(--border-color);
		color: var(--text-secondary);
		padding: 6px;
		border-radius: 6px;
		cursor: pointer;
		opacity: 0;
		transition: all 0.2s ease;
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 10;
	}

	:global(pre:hover) :global(.copy-code-btn) {
		opacity: 1;
	}

	:global(pre) :global(.copy-code-btn:hover) {
		background-color: var(--bg-tertiary);
		border-color: var(--accent);
		color: var(--accent);
	}

	:global(pre) :global(.copy-code-btn.copied) {
		background-color: rgba(16, 185, 129, 0.1);
		border-color: #10b981;
		color: #10b981;
	}

	/* Article Footer */
	.article-footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem;
		padding: 1rem 0;
	}

	.share-section {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.share-label {
		font-weight: 700;
		font-size: 0.9rem;
		color: var(--text-primary);
	}

	.share-buttons {
		display: flex;
		gap: 0.5rem;
	}

	.share-btn {
		background: none;
		border: 1px solid var(--border-color);
		color: var(--text-secondary);
		padding: 0.5rem;
		border-radius: 8px;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: all 0.2s ease;
	}

	.share-btn:hover {
		border-color: var(--accent);
		color: var(--accent);
		background-color: var(--bg-tertiary);
		transform: translateY(-1px);
	}

	/* Post newsletter box */
	.post-newsletter {
		margin-top: 3rem;
		padding: 2rem;
		border-radius: 16px;
		text-align: center;
	}

	.post-newsletter h3 {
		font-size: 1.35rem;
		font-weight: 800;
		margin-bottom: 0.5rem;
	}

	.post-newsletter p {
		font-size: 0.95rem;
		color: var(--text-secondary);
		margin-bottom: 1.25rem;
	}

	.post-newsletter .newsletter-form {
		display: flex;
		gap: 0.5rem;
		max-width: 440px;
		margin: 0 auto;
	}

	.post-newsletter .newsletter-form input {
		flex: 1;
		padding: 0.6rem 1rem;
		font-size: 0.9rem;
		border: 1px solid var(--border-color);
		border-radius: 8px;
		outline: none;
		background-color: var(--bg-secondary);
		color: var(--text-primary);
	}

	.post-newsletter .newsletter-form input:focus {
		border-color: var(--accent);
	}

	.post-newsletter .newsletter-form button {
		background-color: var(--accent);
		color: #ffffff;
		border: none;
		padding: 0.6rem 1.2rem;
		font-size: 0.9rem;
		font-weight: 700;
		border-radius: 8px;
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.post-newsletter .newsletter-form button:hover {
		background-color: var(--accent-hover);
	}

	/* About Author Card */
	.about-author-card {
		margin-top: 2rem;
		padding: 2rem;
		border-radius: 16px;
		display: flex;
		gap: 1.5rem;
		align-items: center;
	}

	.author-bio h3 {
		font-size: 1.2rem;
		margin-bottom: 0.5rem;
		color: var(--text-primary);
	}

	.author-bio p {
		font-size: 0.9rem;
		color: var(--text-secondary);
		margin-bottom: 0;
		line-height: 1.6;
	}

	/* Related Posts Section */
	.related-posts-section {
		margin-top: 4rem;
		border-top: 1px solid var(--border-color);
		padding-top: 3rem;
	}

	.related-posts-section h2 {
		font-size: 1.65rem;
		font-weight: 800;
		margin-bottom: 1.75rem;
		letter-spacing: -0.02em;
	}

	.related-posts-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.5rem;
	}

	.related-card {
		padding: 1.5rem;
		border-radius: 16px;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		text-decoration: none;
		transition: all 0.25s ease;
		height: 100%;
	}

	.related-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-md);
		border-color: var(--accent);
	}

	.related-card h3 {
		font-size: 1.15rem;
		color: var(--text-primary);
		line-height: 1.3;
		margin: 0.75rem 0;
	}

	.related-card p {
		font-size: 0.9rem;
		color: var(--text-secondary);
		line-height: 1.5;
		margin-bottom: 1.25rem;
		flex: 1;
	}

	.related-card .read-link {
		font-weight: 700;
		font-size: 0.85rem;
		color: var(--accent);
	}

	@media (max-width: 768px) {
		.prose-layout {
			padding: 2rem 1.5rem;
		}

		.hero-image-container {
			margin: 1.5rem -1.5rem;
		}

		.about-author-card {
			flex-direction: column;
			text-align: center;
		}

		.post-newsletter .newsletter-form {
			flex-direction: column;
		}

		.post-newsletter .newsletter-form button {
			width: 100%;
		}
	}
</style>
