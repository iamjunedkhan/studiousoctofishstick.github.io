---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import readingTime from "reading-time";

type Props = CollectionEntry<"blog">["data"] & { body?: string };

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  category,
  author,
  body = "",
} = Astro.props;

// Calculate reading time
const rTimeStats = readingTime(body);
const readingTimeText = rTimeStats.text;

// Retrieve related posts (same category, different title)
const allPosts = await getCollection("blog");
let relatedPosts = allPosts.filter(
  (p) => p.data.title !== title && p.data.category === category,
);

if (relatedPosts.length === 0) {
  relatedPosts = allPosts.filter((p) => p.data.title !== title).slice(0, 2);
} else {
  relatedPosts = relatedPosts.slice(0, 2);
}
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={heroImage} />
  </head>

  <body>
    <Header />
    <div id="reading-progress-bar" class="reading-progress"></div>

    <main class="article-container">
      <div class="reading-layout-grid">
        <div class="main-content-column">
          <article class="prose-layout">
            <header class="article-header">
              <div class="header-meta">
                {
                  category && (
                    <a
                      href={`${import.meta.env.BASE_URL}/blog/categories/${category.toLowerCase().replace(/\s+/g, "-")}`}
                      class={`category-badge ${category.toLowerCase().replace(/\s+/g, "-")}`}
                    >
                      {category}
                    </a>
                  )
                }
                <span class="read-time">• {readingTimeText}</span>
              </div>

              <h1>{title}</h1>
              <p class="subtitle-desc">{description}</p>

              <div class="author-bar">
                <div class="author-avatar">
                  {author ? author.charAt(0) : "J"}
                </div>
                <div class="author-details">
                  <span class="author-name">{author || "Juned Khan"}</span>
                  <span class="publish-dates">
                    Published <FormattedDate date={pubDate} />
                    {
                      updatedDate && (
                        <>
                          {" "}
                          (Updated <FormattedDate date={updatedDate} />)
                        </>
                      )
                    }
                  </span>
                </div>
              </div>
            </header>

            {
              heroImage && (
                <div class="hero-image-container">
                  <Image
                    src={heroImage}
                    alt={title}
                    class="hero-img"
                  />
                </div>
              )
            }

            <hr class="divider" />

            <div class="article-body">
              <slot />
            </div>

            <hr class="divider" />

            <footer class="article-footer">
              <div class="share-section">
                <span class="share-label">Share Article:</span>
                <div class="share-buttons">
                  <button
                    id="share-x"
                    class="share-btn"
                    aria-label="Share on X"
                  >
                    <svg
                      viewBox="0 0 24 24"
                      width="16"
                      height="16"
                      stroke="currentColor"
                      stroke-width="2"
                      fill="none"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      ><path d="M4 4l11.733 16h4.267l-11.733 -16z"></path><path
                        d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"
                      ></path></svg
                    >
                  </button>
                  <button
                    id="share-linkedin"
                    class="share-btn"
                    aria-label="Share on LinkedIn"
                  >
                    <svg
                      viewBox="0 0 24 24"
                      width="16"
                      height="16"
                      stroke="currentColor"
                      stroke-width="2"
                      fill="none"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      ><path
                        d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
                      ></path><rect x="2" y="9" width="4" height="12"
                      ></rect><circle cx="4" cy="4" r="2"></circle></svg
                    >
                  </button>
                  <button
                    id="share-copy"
                    class="share-btn"
                    aria-label="Copy Link"
                  >
                    <svg
                      viewBox="0 0 24 24"
                      width="16"
                      height="16"
                      stroke="currentColor"
                      stroke-width="2"
                      fill="none"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      ><rect x="9" y="9" width="13" height="13" rx="2" ry="2"
                      ></rect><path
                        d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
                      ></path></svg
                    >
                  </button>
                </div>
              </div>
            </footer>

            <!-- Newsletter Box -->
            <section class="post-newsletter glass">
              <h3>Enjoyed this post?</h3>
              <p>
                Subscribe to our newsletter and never miss Salesforce triggers,
                LWC, or integration tips!
              </p>
              <form
                class="newsletter-form"
                onsubmit="event.preventDefault(); alert('Subscribed! (Simulated)'); this.reset();"
              >
                <input
                  type="email"
                  placeholder="Your email address"
                  required
                  aria-label="Email Address"
                />
                <button type="submit">Subscribe</button>
              </form>
            </section>
          </article>
        </div>

        <aside class="reading-sidebar">
          <!-- Author Card Widget -->
          <div class="sidebar-widget author-sidebar-widget glass">
            <h3 class="widget-title">
              <svg
                viewBox="0 0 24 24"
                width="18"
                height="18"
                stroke="currentColor"
                stroke-width="2"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"
                ></path><circle cx="12" cy="7" r="4"></circle></svg
              >
              Author
            </h3>
            <div class="author-sidebar-info">
              <div class="author-avatar">{author ? author.charAt(0) : "J"}</div>
              <div class="author-sidebar-details">
                <span class="author-name">{author || "Juned Khan"}</span>
                <span class="author-role">Salesforce Developer</span>
              </div>
            </div>
            <p class="author-sidebar-bio">
              {author || "Juned Khan"} is a Salesforce Developer and Technical Writer
              who specializes in Apex, LWC, Agentforce, API Integrations, and Salesforce
              system design.
            </p>
          </div>

          <!-- Table of Contents Widget -->
          <div class="sidebar-widget toc-sidebar-widget glass">
            <h3 class="widget-title">
              <svg
                viewBox="0 0 24 24"
                width="18"
                height="18"
                stroke="currentColor"
                stroke-width="2"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><line x1="8" y1="6" x2="21" y2="6"></line><line
                  x1="8"
                  y1="12"
                  x2="21"
                  y2="12"></line><line x1="8" y1="18" x2="21" y2="18"
                ></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line
                  x1="3"
                  y1="12"
                  x2="3.01"
                  y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"
                ></line></svg
              >
              Table of Contents
            </h3>
            <nav class="toc-nav" id="toc-container">
              <ul id="toc-list">
                <!-- dynamically populated by JS -->
              </ul>
            </nav>
          </div>

          <!-- Related Publications Widget -->
          {
            relatedPosts.length > 0 && (
              <div class="sidebar-widget related-sidebar-widget glass">
                <h3 class="widget-title">
                  <svg
                    viewBox="0 0 24 24"
                    width="18"
                    height="18"
                    stroke="currentColor"
                    stroke-width="2"
                    fill="none"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <>
                      <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                      <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                    </>
                  </svg>
                  Related Articles
                </h3>
                <div class="related-sidebar-list">
                  {relatedPosts.map((rPost) => (
                    <a
                      href={`${import.meta.env.BASE_URL}/blog/${rPost.id.replace("/index", "")}/`}
                      class="related-sidebar-item"
                    >
                      {rPost.data.category && (
                        <span
                          class={`tag-badge ${rPost.data.category.toLowerCase().replace(/\s+/g, "-")}`}
                        >
                          {rPost.data.category}
                        </span>
                      )}
                      <span class="related-sidebar-title">
                        {rPost.data.title}
                      </span>
                    </a>
                  ))}
                </div>
              </div>
            )
          }
        </aside>
      </div>
    </main>

    <Footer />

    <!-- Reading progress bar script -->
    <script>
      window.addEventListener("scroll", () => {
        const progressBar = document.getElementById("reading-progress-bar");
        if (progressBar) {
          const winScroll =
            document.body.scrollTop || document.documentElement.scrollTop;
          const height =
            document.documentElement.scrollHeight -
            document.documentElement.clientHeight;
          const scrolled = (winScroll / height) * 100;
          progressBar.style.width = scrolled + "%";
        }
      });
    </script>

    <!-- Table of Contents generation and ScrollSpy script -->
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const articleBody = document.querySelector(".article-body");
        const tocList = document.getElementById("toc-list");

        if (!articleBody || !tocList) return;

        const headings = articleBody.querySelectorAll("h2, h3");

        if (headings.length === 0) {
          const tocWidget = document.querySelector(".toc-sidebar-widget");
          if (tocWidget) {
            tocWidget.style.display = "none";
          }
          return;
        }

        const headingData = Array.from(headings).map((heading, index) => {
          if (!heading.id) {
            heading.id = heading.textContent
              ? heading.textContent
                  .toLowerCase()
                  .replace(/[^a-z0-9]+/g, "-")
                  .replace(/(^-|-$)/g, "")
              : "heading-" + index;
          }
          return {
            id: heading.id,
            text: heading.textContent || "",
            tagName: heading.tagName.toLowerCase(),
            element: heading,
          };
        });

        headingData.forEach((h) => {
          const li = document.createElement("li");
          li.className = "toc-item toc-" + h.tagName;

          const a = document.createElement("a");
          a.href = "#" + h.id;
          a.textContent = h.text;
          a.className = "toc-link";

          li.appendChild(a);
          tocList.appendChild(li);
        });

        const tocLinks = tocList.querySelectorAll(".toc-link");

        function updateActiveToc() {
          const scrollPos =
            window.scrollY || document.documentElement.scrollTop;
          let activeId = "";

          for (let i = headingData.length - 1; i >= 0; i--) {
            const heading = headingData[i];
            const rect = heading.element.getBoundingClientRect();
            const top = rect.top + window.scrollY;

            if (scrollPos >= top - 150) {
              activeId = heading.id;
              break;
            }
          }

          if (!activeId && headingData.length > 0) {
            activeId = headingData[0].id;
          }

          tocLinks.forEach((link) => {
            const href = link.getAttribute("href");
            if (href === "#" + activeId) {
              link.classList.add("active");
            } else {
              link.classList.remove("active");
            }
          });
        }

        updateActiveToc();
        window.addEventListener("scroll", updateActiveToc);
      });
    </script>

    <!-- Copy code block script -->
    <script>
      const blocks = document.querySelectorAll("pre");

      blocks.forEach((block) => {
        const button = document.createElement("button");
        button.className = "copy-code-btn";
        button.type = "button";
        button.ariaLabel = "Copy code";
        button.innerHTML =
          '<svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="copy-icon"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';

        block.style.position = "relative";
        block.appendChild(button);

        button.addEventListener("click", async () => {
          const code = block.querySelector("code");
          const text = code ? code.innerText : "";

          try {
            await navigator.clipboard.writeText(text);
            button.innerHTML =
              '<svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg>';
            button.classList.add("copied");

            setTimeout(() => {
              button.innerHTML =
                '<svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="copy-icon"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
              button.classList.remove("copied");
            }, 2000);
          } catch (err) {
            console.error("Failed to copy: ", err);
          }
        });
      });
    </script>

    <!-- Share Buttons Script -->
    <script>
      const shareBtnCopy = document.getElementById("share-copy");
      const shareBtnX = document.getElementById("share-x");
      const shareBtnLinkedin = document.getElementById("share-linkedin");

      const pageUrl = window.location.href;
      const pageTitle = document.title;

      if (shareBtnCopy) {
        shareBtnCopy.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(pageUrl);
            alert("Link copied to clipboard!");
          } catch (err) {
            console.error(err);
          }
        });
      }

      if (shareBtnX) {
        shareBtnX.addEventListener("click", () => {
          window.open(
            `https://twitter.com/intent/tweet?text=${encodeURIComponent(pageTitle)}&url=${encodeURIComponent(pageUrl)}`,
            "_blank",
          );
        });
      }

      if (shareBtnLinkedin) {
        shareBtnLinkedin.addEventListener("click", () => {
          window.open(
            `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`,
            "_blank",
          );
        });
      }
    </script>
  </body>
</html>

<style>
  /* Reading progress bar */
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    width: 0%;
    height: 4px;
    background: var(--accent-gradient);
    z-index: 1001;
    transition: width 0.1s ease;
  }

  .article-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .reading-layout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  .main-content-column {
    min-width: 0;
  }

  @media (min-width: 992px) {
    .reading-layout-grid {
      grid-template-columns: 1fr 320px;
    }
  }

  .prose-layout {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 24px;
    padding: 3rem;
    box-shadow: var(--shadow-sm);
    transition: all 0.3s ease;
    max-width: 100%;
    overflow: hidden;
  }

  .reading-sidebar {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    position: sticky;
    top: 90px;
    height: fit-content;
  }

  .article-header {
    margin-bottom: 2.5rem;
  }

  .header-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .category-badge {
    padding: 0.3rem 0.9rem;
    border-radius: 99px;
    font-size: 0.775rem;
    font-weight: 700;
    text-transform: uppercase;
    display: inline-block;
    text-decoration: none;
  }

  .category-badge.apex {
    background-color: rgba(1, 118, 211, 0.1);
    color: #0176d3;
  }
  .category-badge.lwc {
    background-color: rgba(16, 185, 129, 0.1);
    color: #10b981;
  }
  .category-badge.agentforce {
    background-color: rgba(139, 92, 246, 0.1);
    color: #8b5cf6;
  }
  .category-badge.integrations {
    background-color: rgba(245, 158, 11, 0.1);
    color: #f59e0b;
  }
  .category-badge.salesforce-dev-notes {
    background-color: rgba(79, 70, 229, 0.1);
    color: #4f46e5;
  }

  .tag-badge {
    padding: 0.25rem 0.75rem;
    border-radius: 99px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    display: inline-block;
    text-decoration: none;
    align-self: flex-start;
  }
  .tag-badge.apex {
    background-color: rgba(1, 118, 211, 0.1);
    color: #0176d3;
  }
  .tag-badge.lwc {
    background-color: rgba(16, 185, 129, 0.1);
    color: #10b981;
  }
  .tag-badge.agentforce {
    background-color: rgba(139, 92, 246, 0.1);
    color: #8b5cf6;
  }
  .tag-badge.integrations {
    background-color: rgba(245, 158, 11, 0.1);
    color: #f59e0b;
  }
  .tag-badge.salesforce-dev-notes {
    background-color: rgba(79, 70, 229, 0.1);
    color: #4f46e5;
  }

  .read-time {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .article-header h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.03em;
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 1rem;
  }

  .subtitle-desc {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }

  .author-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    padding: 1rem 0;
  }

  .author-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--accent-gradient);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1rem;
  }

  .author-details {
    display: flex;
    flex-direction: column;
  }

  .author-name {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .publish-dates {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .hero-image-container {
    margin: 2rem -3rem;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: var(--bg-tertiary);
    border-radius: 16px;
    border: 1px solid var(--border-color);
  }

  .hero-img {
    max-width: 100%;
    height: auto;
    max-height: 500px;
    object-fit: contain;
    display: block;
  }

  .divider {
    border: none;
    border-top: 1px solid var(--border-color);
    margin: 2rem 0;
  }

  /* Main prose body styling */
  .article-body {
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .article-body :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .article-body :global(p) {
    margin-bottom: 1.5rem;
  }

  .article-body :global(h2) {
    font-size: 1.65rem;
    letter-spacing: -0.02em;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-weight: 800;
    scroll-margin-top: 100px;
  }

  .article-body :global(h3) {
    font-size: 1.3rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-weight: 700;
    scroll-margin-top: 100px;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .article-body :global(li) {
    margin-bottom: 0.5rem;
  }

  .article-body :global(blockquote) {
    border-left: 4px solid var(--accent);
    padding: 0.5rem 0 0.5rem 1.5rem;
    margin: 1.75rem 0;
    font-style: italic;
    color: var(--text-muted);
    background-color: var(--bg-tertiary);
    border-radius: 0 12px 12px 0;
  }

  .article-body :global(img) {
    border-radius: 12px;
    margin: 2rem auto;
    display: block;
    max-width: 100%;
    height: auto;
    box-shadow: var(--shadow-sm);
  }

  /* Inline Copy button styling */
  :global(pre) :global(.copy-code-btn) {
    position: absolute;
    top: 10px;
    right: 10px;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    padding: 6px;
    border-radius: 6px;
    cursor: pointer;
    opacity: 0;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
  }

  :global(pre:hover) :global(.copy-code-btn) {
    opacity: 1;
  }

  :global(pre) :global(.copy-code-btn:hover) {
    background-color: var(--bg-tertiary);
    border-color: var(--accent);
    color: var(--accent);
  }

  :global(pre) :global(.copy-code-btn.copied) {
    background-color: rgba(16, 185, 129, 0.1);
    border-color: #10b981;
    color: #10b981;
  }

  /* Article Footer */
  .article-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1rem 0;
  }

  .share-section {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .share-label {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--text-primary);
  }

  .share-buttons {
    display: flex;
    gap: 0.5rem;
  }

  .share-btn {
    background: none;
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    padding: 0.5rem;
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .share-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    background-color: var(--bg-tertiary);
    transform: translateY(-1px);
  }

  /* Post newsletter box */
  .post-newsletter {
    margin-top: 3rem;
    padding: 2rem;
    border-radius: 16px;
    text-align: center;
  }

  .post-newsletter h3 {
    font-size: 1.35rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .post-newsletter p {
